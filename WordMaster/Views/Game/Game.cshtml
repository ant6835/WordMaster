@model GameState
@{
	ViewData["Title"] = "Game";
}

<form asp-action="Guess" method="post" class="mb-5">
	<div asp-validation-summary="All" class="text-danger"></div>

	<input type="hidden" asp-for="Word" />
	<input type="hidden" asp-for="WordLength" />
	<input type="hidden" asp-for="TotalGuesses" />
	<input type="hidden" asp-for="CurrentGuesses" />
	<input type="hidden" asp-for="WonGame" />

	<div class="mb-3">
		<label asp-for="Guess" class="form-label">Guess</label>
		<input asp-for="Guess" class="form-control">
	</div>

	<button type="submit" class="btn btn-primary">Guess Word</button>
</form>

<div class="mb-3">
	<form asp-action="GameOver" method="post" class="d-inline">
		<input type="hidden" name="retry" value="true" />
		<button type="submit" class="btn btn-success">
			New Game
		</button>
	</form>

	<form asp-action="GameOver" method="post" class="d-inline">
		<input type="hidden" name="retry" value="false" />
		<button type="submit" class="btn btn-danger">
			Give Up
		</button>
	</form>
</div>

<div class="d-flex flex-column align-items-center gap-2 mb-4">
	@for (int g = 0; g < Model.TotalGuesses; g++)
	{
		if (!TempData.ContainsKey($"Guess{g}")) continue;
		string word = (string)TempData.Peek($"Guess{g}");

		<div class="d-flex flex-row gap-2">
			@for (int i = 0; i < Model.WordLength; i++)
			{
				char letter = string.IsNullOrEmpty(word) ? ' ' : word[i];

				string color = "bg-light text-dark";

				if (!string.IsNullOrEmpty(word))
				{
					if (word[i] == Model.Word[i])
					{
						color = "bg-success text-white";
					}
					else if (Model.Word.Contains(word[i]))
					{
						color = "bg-warning text-dark";
					}
					else
					{
						color = "bg-secondary text-dark";
					}
				}

				<div class="letter-box border rounded @color">
					@letter
				</div>
			}
		</div>
	}
</div>