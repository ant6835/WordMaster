@model GameState
@{
	ViewData["Title"] = "Game";
}

<form asp-action="Guess" method="get" class="mb-5">
	<div asp-validation-summary="All" class="text-danger"></div>

	<div class="mb-3">
		<label asp-for="Guess" class="form-label">Guess</label>
		<input asp-for="Guess" class="form-control">
	</div>

	<button type="submit" class="btn btn-primary">Guess Word</button>
	<button type="button" value="true" asp-action="GameOver">New Game</button>
	<button type="button" value="false" asp-action="GameOver">Give Up</button>
</form>

<div class="col-6 align-content-center">
	@foreach (var word in Model.PreviousGuesses)
	{
		<div class="flex-row align-content-around">
			@for (int i = 0; i < Model.WordLength; i++)
			{
				char letter = word == null ? ' ' : word[i];

				string color = "secondary";
				if (word != null)
				{
					if (Model.IndexIsCorrect(i))
						color = "success";
					else if (Model.WordHasIndex(i))
						color = "warning";
				}

				<p class="border-1 m-1">
					@letter
				</p>
			}
		</div>
	}
</div>